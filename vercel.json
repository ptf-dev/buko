{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?route=:path*"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/dashboard.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ],
  "redirects": [
    {
      "source": "/store/:id",
      "destination": "/app/store/:id"
    },
    {
      "source": "/partner",
      "destination": "/dashboard"
    },
    {
      "source": "/app/partner",
      "destination": "/dashboard"
    },
    {
      "source": "/downloads/buko.apk",
      "destination": "/downloads/ngopu.apk"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        }
      ]
    }
  ]
}
